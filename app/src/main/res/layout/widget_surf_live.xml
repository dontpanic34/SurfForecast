<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingVertical="4dp"
    android:paddingHorizontal="6dp"
    android:gravity="center_vertical">

    <!-- Bloc 1 : Houle & Mer -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.0"
        android:orientation="horizontal"
        android:gravity="center_vertical|start">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🌊"
            android:textSize="10sp"
            android:shadowColor="#CC000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="3" />

        <TextView
            android:id="@+id/widget_text_swell"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="3dp"
            android:text="--m - --s - --°C"
            android:textColor="#FFFFFF"
            android:textSize="9.5sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:shadowColor="#CC000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="3" />
    </LinearLayout>

    <!-- Séparateur 1 -->
    <ImageView
        android:layout_width="1dp"
        android:layout_height="13dp"
        android:background="#40FFFFFF"
        android:layout_marginHorizontal="3dp"
        android:contentDescription="@null" />

    <!-- Bloc 2 : Marée avec icônes vaguelette + flèche -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.25"
        android:orientation="horizontal"
        android:gravity="center">

        <!-- Marée haute -->
        <ImageView
            android:id="@+id/widget_img_tide_high"
            android:layout_width="11dp"
            android:layout_height="11dp"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/widget_text_tide_high"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:text="--h-- (--)"
            android:textColor="#FFFFFF"
            android:textSize="9sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:shadowColor="#CC000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="3" />

        <!-- Marée basse (espacement géré par layout_marginStart) -->
        <ImageView
            android:id="@+id/widget_img_tide_low"
            android:layout_width="11dp"
            android:layout_height="11dp"
            android:layout_marginStart="5dp"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/widget_text_tide_low"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:text="--h--"
            android:textColor="#FFFFFF"
            android:textSize="9sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:shadowColor="#CC000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="3" />
    </LinearLayout>

    <!-- Séparateur 2 -->
    <ImageView
        android:layout_width="1dp"
        android:layout_height="13dp"
        android:background="#40FFFFFF"
        android:layout_marginHorizontal="3dp"
        android:contentDescription="@null" />

    <!-- Bloc 3 : Vent aligné à gauche vers le séparateur -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.15"
        android:orientation="horizontal"
        android:gravity="center_vertical|start"
        android:paddingStart="2dp">

        <ImageView
            android:id="@+id/widget_img_wind_breeze"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/widget_text_wind_dir"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="3dp"
            android:text="--"
            android:textColor="#FFD600"
            android:textSize="9sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:shadowColor="#CC000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="3" />

        <ImageView
            android:id="@+id/widget_img_wind_arrow"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginStart="3dp"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/widget_text_wind_speed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="3dp"
            android:text="-- km/h"
            android:textColor="#FFD600"
            android:textSize="9sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:shadowColor="#CC000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="3" />
    </LinearLayout>

</LinearLayout>
