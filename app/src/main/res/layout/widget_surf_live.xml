<?xml version="1.0" encoding="utf-8"?>
<!--
    Widget "montre" : cercle qui fait le tour du widget representant la maree
    (bas = basse mer, haut = pleine mer), infos (houle/vent/temperature) au centre.
    L'anneau est un bitmap pre-rendu (RemoteViews ne permet pas de Canvas custom),
    regenere a la taille exacte du widget via onAppWidgetOptionsChanged.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_round_bg">

    <ImageView
        android:id="@+id/widget_img_tide_ring"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center">

        <TextView
            android:id="@+id/widget_text_wave"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--m"
            android:textColor="#FFFFFF"
            android:textSize="21sp"
            android:textStyle="bold"
            android:singleLine="true" />

        <TextView
            android:id="@+id/widget_text_wave_sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:text="--s · --°C"
            android:textColor="#B3FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold"
            android:singleLine="true" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/widget_img_wind_arrow"
                android:layout_width="11dp"
                android:layout_height="11dp"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/widget_text_wind_dir"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:text="--"
                android:textColor="#FFD600"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:singleLine="true" />

            <TextView
                android:id="@+id/widget_text_wind_speed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:text="-- km/h"
                android:textColor="#FFD600"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:singleLine="true" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
