<?xml version="1.0" encoding="utf-8"?>
<!--
    Fond carre a bords arrondis du widget. Auparavant un ovale plein cadre : comme le
    launcher (Niagara, launcher par defaut...) n'accorde pas toujours un cadre carre au
    widget, un ovale etire sur un cadre non carre donnait une forme allongee disgracieuse.
    Un rectangle a coins arrondis reste propre quel que soit le cadre reellement obtenu ;
    l'anneau de maree (dessine en bitmap dans SurfOverlayWidgetProvider) reste lui un vrai
    cercle, centre et redimensionne independamment de la forme de ce fond.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#EB1A1E24" />
    <corners android:radius="24dp" />
    <stroke
        android:width="1dp"
        android:color="#22FFFFFF" />
</shape>
