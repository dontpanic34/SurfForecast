/*
  Cache-Control: no-cache

# Les deux gros fichiers WebAssembly (5 Mo compressés) portent le hachage de leur contenu dans leur nom : un nouveau contenu
# donne un nouveau nom. On peut donc les garder un an sans redemander au serveur : au retour, l'appli démarre sans réseau
# lent à traverser (iPhone en 4G faible à la plage).
/*.wasm
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable
